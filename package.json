{
  "name": "m3s-backend",
  "version": "1.0.0",
  "description": "M3S ERP Backend - Node.js + BigQuery",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "bash test-api.sh",
    "test:cors": "node scripts/test-cors-policy.js",
    "test:debug-access": "node scripts/testDebugAccess.js",
    "test:unit": "node --test tests/*.test.js",
    "auth:hash": "node scripts/hash-password.js",
    "validate:taxonomy": "node scripts/validateOfferTaxonomy.js",
    "validate:ref01": "node scripts/validateRef01Migrations.mjs",
    "compare:taxonomy": "node scripts/compareOfferTaxonomy.js",
    "test:rh001": "node scripts/testRh001MembersDirectory.js",
    "test:intelligence": "node scripts/testIntelligenceDashboard.js",
    "test:administration-registries": "node scripts/testAdministrationRegistries.js",
    "test:management-portfolio": "node scripts/testManagementPortfolio.js",
    "test:finance-access": "node scripts/testFinanceAccess.js",
    "test:finance-scope": "node scripts/testFinanceDataScope.js",
    "test:finance-sources": "node scripts/testFinanceSources.js",
    "test:finance-transaction": "node scripts/testFinanceTransaction.js",
    "test:suppliers-count": "node scripts/testSupplierCount.js",
    "test:beneficiaries-count": "node scripts/testBeneficiaryCount.js",
    "test:donors-count": "node scripts/testDonorCount.js",
    "finance:import:sources": "node scripts/importFinanceSources.js"
  },
  "keywords": [
    "erp",
    "bigquery",
    "api",
    "m3s"
  ],
  "author": "M3S Team",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@google-cloud/bigquery": "^7.0.0",
    "body-parser": "^1.20.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "18.x"
  }
}
